<Window x:Class="copyutil.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipPilot 设置"
        Width="300"
        Height="240"
        MinWidth="300"
        MinHeight="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/Images/clip_pilot_icon.png">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Background="#FFF8FBFF" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="基础设置" FontSize="16" FontWeight="Bold" Foreground="#1F2A44" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1">
            <CheckBox x:Name="ClipboardMonitorCheckBox" Content="启用剪贴板监听" Margin="0,6" />
            <CheckBox x:Name="DragCopyCheckBox" Content="启用拖拽复制" Margin="0,6" />
            <CheckBox x:Name="SuccessTipCheckBox" Content="显示操作成功提示" Margin="0,6" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button Content="保存" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
