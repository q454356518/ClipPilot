<Window x:Class="copyutil.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipPilot"
        Width="195"
        Height="214"
        Icon="pack://application:,,,/Assets/Images/clip_pilot_icon.png"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="19" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="Foreground" Value="#243B66" />
            <Setter Property="BorderBrush" Value="#9EC5FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Canvas x:Name="RootCanvas">
        <Border x:Name="BubblePanel"
                Canvas.Left="8"
                Canvas.Top="8"
                Width="94"
                Height="166"
                Background="#F7FFFFFF"
                BorderBrush="#9EC5FF"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="6,5"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.24" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="DetectedTypeText"
                           Text="发现文件"
                           Foreground="#1F2A44"
                           FontSize="11"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DetectedNameText"
                           Foreground="#5B6B88"
                           FontSize="9"
                           Margin="0,2,0,4"
                           MaxWidth="78"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />

                <Button x:Name="CopyFileButton" Content="复制文件" Click="CopyFileButton_Click" />
                <Button x:Name="CopyPathButton" Content="复制路径" Click="CopyPathButton_Click" />
                <Button x:Name="CopyNameButton" Content="复制名称" Click="CopyNameButton_Click" />
                <Button x:Name="OpenFileButton" Content="打开" Click="OpenFileButton_Click" />
                <Button x:Name="OpenButton" Content="打开目录" Click="OpenButton_Click" />
            </StackPanel>
        </Border>

        <Border x:Name="DragTip"
                Canvas.Left="92"
                Canvas.Top="72"
                Background="#F7FFFFFF"
                BorderBrush="#9EC5FF"
                BorderThickness="1"
                CornerRadius="9"
                Padding="7,4"
                Visibility="Collapsed">
            <TextBlock x:Name="StatusText" Text="松开复制路径" Foreground="#243B66" FontSize="10" />
        </Border>

        <Image x:Name="MascotImage"
               Canvas.Left="89"
               Canvas.Top="106"
               MouseLeftButtonDown="MascotImage_MouseLeftButtonDown"
               Cursor="Hand"
               Width="100"
               Height="100"
               RenderOptions.BitmapScalingMode="HighQuality"
               RenderOptions.EdgeMode="Aliased"
               SnapsToDevicePixels="True"
               Source="pack://application:,,,/Assets/Images/clip_pilot_mascot.png"
               Stretch="Uniform" />
    </Canvas>
</Window>
